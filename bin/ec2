#!/bin/bash

set -e

ROOT_DIR="$HOME/.ec2-cli"

COMMAND="$1"
TARGET="$2"

case "$COMMAND" in

  run)
    if [ -z "$TARGET" ]; then
      echo "Usage: ec2 run <app|mysql|all>"
      exit 1
    fi

    "$ROOT_DIR/scripts/run.sh" "$TARGET"
    ;;

  stop)
    if [ -z "$TARGET" ]; then
      echo "Usage: ec2 stop <app|mysql|all>"
      exit 1
    fi

    "$ROOT_DIR/scripts/stop.sh" "$TARGET"
    ;;

  conn)
    if [ -z "$TARGET" ]; then
      echo "Usage: ec2 conn <app|mysql|postgres|all>"
      exit 1
    fi

    "$ROOT_DIR/scripts/conn.sh" "$TARGET"
    ;;

  *)
    echo ""
    echo "EC2 CLI"
    echo ""
    echo "Usage:"
    echo "  ec2 run app"
    echo "  ec2 run mysql"
    echo "  ec2 run all"
    echo ""
    echo "  ec2 stop app"
    echo "  ec2 stop mysql"
    echo "  ec2 stop all"
    echo ""
    echo "  ec2 conn app       # 켜져 있는 인스턴스의 IP 로 내 ssh config 갱신"
    echo "  ec2 conn mysql"
    echo "  ec2 conn all"
    echo ""
    exit 1
    ;;
esac